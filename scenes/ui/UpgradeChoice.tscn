[ext_resource type="Theme" path="res://assets/provisional/controls.tres" id="2_theme"]

[node name="UpgradeChoice" type="PanelContainer"]
theme = ExtResource("2_theme")
visible = false
layout_mode = 3
anchors_preset = 15
